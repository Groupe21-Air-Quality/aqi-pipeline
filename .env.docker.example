# Copier ce fichier en .env à la racine du repo AVANT de lancer docker compose.
# Ce fichier .env est dans .gitignore : ne JAMAIS le commiter avec de vraies valeurs.

# UID de votre utilisateur Linux/Mac (évite les problèmes de permissions sur les volumes).
# Sous Linux/Mac : lancer `id -u` dans un terminal et coller le résultat.
# Sous Windows (Docker Desktop) : laisser 50000.
AIRFLOW_UID=50000

# Clé API OpenWeatherMap
OWM_API_KEY=your_openweathermap_api_key_here

# Connexion au data warehouse PostgreSQL distant (Supabase/Neon)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Pour que le conteneur Airflow puisse pousser data/raw et data/clean vers GitHub.
# Créer un Personal Access Token (PAT) GitHub avec le scope "repo", puis :
GIT_REPO_URL=https://<votre_token>@github.com/<votre_org>/<votre_repo>.git
GIT_USER_NAME=aqi-pipeline-bot
GIT_USER_EMAIL=aqi-pipeline-bot@users.noreply.github.com
